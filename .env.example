# Database (SQLite dev default; use Postgres in production)
DATABASE_URL=sqlite:///./data/leads.db
# DATABASE_URL=postgresql+psycopg2://lead:lead@db:5432/lead_tracker

# LLM (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# false = fast webhook + background LLM; true = wait for LLM (tests use true)
ENRICH_SYNC=false

# Optional HMAC verification (X-Webhook-Signature: sha256=<hex>)
WEBHOOK_SECRET=
